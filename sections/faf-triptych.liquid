{% comment %}
  Section contract.
  House of FAF: triptych. Three small photos in a row, shown uncropped at their own proportions, each with an italic caption,
  on generous white space. The middle photo sits lower on desktop for an editorial rhythm.
  On phones the row scrolls sideways with snap points instead of shrinking the photos.
  Sized for modest source images: photos never render wider than about 340px.
  @example
  <!-- Home page, after the bestsellers row: Ready-to-wear · Timeless pieces · Modern feminine -->
{% endcomment %}

<div class="faf-triptych">
  {% if section.settings.eyebrow != blank %}
    <p class="faf-eyebrow faf-triptych__eyebrow">{{ section.settings.eyebrow | escape }}</p>
  {% endif %}

  <ul
    class="faf-triptych__row"
    role="list"
    tabindex="0"
    aria-label="{{ section.settings.eyebrow | default: 'Photos' | escape }}"
  >
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign demo_key = 'demo_image_' | append: i
        assign caption_key = 'caption_' | append: i
        assign link_key = 'link_' | append: i
        assign image = section.settings[image_key]
        assign demo = section.settings[demo_key]
        assign caption = section.settings[caption_key]
        assign link = section.settings[link_key]
      %}
      <li class="faf-triptych__item">
        {% if link != blank and caption != blank %}
          <a class="faf-triptych__link" href="{{ link }}">
        {% endif %}
        <div class="faf-triptych__media">
          {% if image != blank %}
            {{
              image
              | image_url: width: 900
              | image_tag:
                widths: '300, 450, 680, 900',
                sizes: '(min-width: 750px) 340px, 72vw',
                class: 'faf-triptych__image',
                loading: 'lazy',
                alt: image.alt
            }}
          {% elsif demo != blank %}
            <img class="faf-triptych__image" src="{{ demo | asset_url }}" alt="" loading="lazy" width="300" height="400">
          {% endif %}
        </div>
        {% if caption != blank %}
          <p class="faf-triptych__caption">{{ caption | escape }}</p>
        {% endif %}
        {% if link != blank and caption != blank %}
          </a>
        {% endif %}
      </li>
    {% endfor %}
  </ul>

  {% if section.settings.label != blank %}
    <a class="faf-link faf-triptych__more" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
      {{- section.settings.label | escape -}}
    </a>
  {% endif %}
</div>

{% style %}
  {{ settings.type_heading_font | font_modify: 'weight', '500' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
{% endstyle %}

{% stylesheet %}
  .faf-triptych {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding: 72px 0;
    background: #fff;
    color: #000;
    text-align: center;
  }

  .faf-triptych__row {
    /* Phones: all three photos side by side, no horizontal scrolling */
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 8px;
    width: 100%;
    margin: 0;
    padding: 0 12px;
    list-style: none;
  }

  .faf-triptych__item {
    min-width: 0;
  }

  .faf-triptych__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* Photos keep their own proportions: never cropped */
  .faf-triptych__media {
    overflow: hidden;
  }

  .faf-triptych__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .faf-triptych__caption {
    margin: 16px 0 0;
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.3;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .faf-triptych__link .faf-triptych__image {
      transition: transform 1.2s cubic-bezier(0.2, 0.6, 0.2, 1);
    }

    .faf-triptych__link:hover .faf-triptych__image {
      transform: scale(1.03);
    }
  }

  @media screen and (min-width: 750px) {
    .faf-triptych {
      gap: 48px;
      padding: 120px 40px 112px;
    }

    .faf-triptych__row {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 340px));
      justify-content: center;
      align-items: start;
      gap: clamp(24px, 4vw, 56px);
      padding: 0;
      overflow: visible;
    }

    /* Editorial stagger: the middle photo sits lower */
    .faf-triptych__item:nth-child(2) {
      margin-top: 72px;
    }

    .faf-triptych__caption {
      margin-top: 20px;
      font-size: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAF triptych",
  "class": "faf-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The Collection" },
    { "type": "header", "content": "Left photo" },
    { "type": "image_picker", "id": "image_1", "label": "Image" },
    { "type": "text", "id": "demo_image_1", "label": "Demo image file", "info": "Used until an image is picked above.", "default": "faf-guide-lace-scarf.jpg" },
    { "type": "text", "id": "caption_1", "label": "Italic caption", "default": "Ready-to-wear" },
    { "type": "url", "id": "link_1", "label": "Link", "info": "Optional. Needs a caption." },
    { "type": "header", "content": "Middle photo" },
    { "type": "image_picker", "id": "image_2", "label": "Image" },
    { "type": "text", "id": "demo_image_2", "label": "Demo image file", "info": "Used until an image is picked above.", "default": "faf-guide-lace-dress.jpg" },
    { "type": "text", "id": "caption_2", "label": "Italic caption", "default": "Timeless pieces" },
    { "type": "url", "id": "link_2", "label": "Link", "info": "Optional. Needs a caption." },
    { "type": "header", "content": "Right photo" },
    { "type": "image_picker", "id": "image_3", "label": "Image" },
    { "type": "text", "id": "demo_image_3", "label": "Demo image file", "info": "Used until an image is picked above.", "default": "faf-guide-black-suit.jpg" },
    { "type": "text", "id": "caption_3", "label": "Italic caption", "default": "Modern feminine" },
    { "type": "url", "id": "link_3", "label": "Link", "info": "Optional. Needs a caption." },
    { "type": "header", "content": "Link below" },
    { "type": "text", "id": "label", "label": "Link text", "default": "Discover the collection" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to all products." }
  ],
  "presets": [{ "name": "FAF triptych" }]
}
{% endschema %}
