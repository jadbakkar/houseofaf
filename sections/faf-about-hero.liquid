{% comment %}
  House of FAF: about hero. Full-width photo with the white monogram large and centred, as on the first guideline screen.
{% endcomment %}

{% liquid
  assign image = section.settings.image
%}

<div class="faf-about-hero" style="--faf-mark: url('{{ 'faf-monogram.svg' | asset_url }}'); --faf-about-hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  {% if image != blank %}
    {{
      image
      | image_url: width: 2400
      | image_tag:
        widths: '800, 1200, 1600, 2000, 2400',
        sizes: '100vw',
        class: 'faf-about-hero__image',
        loading: 'eager',
        fetchpriority: 'high',
        alt: image.alt
    }}
  {% else %}
    <img class="faf-about-hero__image" src="{{ 'faf-demo-hero-sofa.jpg' | asset_url }}" alt="" width="2880" height="1635" fetchpriority="high">
  {% endif %}
  <div class="faf-about-hero__content">
    <span class="faf-about-hero__mark faf-mark" role="img" aria-label="House of FAF"></span>
    {% if section.settings.eyebrow != blank %}
      <p class="faf-eyebrow faf-about-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .faf-about-hero {
    position: relative;
    min-height: max(460px, 75vh);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #000;
    color: #fff;
  }

  .faf-about-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--faf-about-hero-overlay, 0.25));
    pointer-events: none;
  }

  .faf-about-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  .faf-about-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 48px 20px;
    text-align: center;
  }

  .faf-about-hero__mark {
    display: block;
    height: clamp(120px, 28vw, 260px);
    aspect-ratio: 2528 / 2288;
  }

  .faf-about-hero__eyebrow {
    letter-spacing: 0.3em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAF about hero",
  "class": "faf-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The House" },
    { "type": "range", "id": "overlay", "label": "Dark overlay", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 25 }
  ],
  "presets": [{ "name": "FAF about hero" }]
}
{% endschema %}
