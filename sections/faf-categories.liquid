{% comment %}
  House of FAF: shop by category. Four portrait tiles, each linking to a collection.
  Uses the collection image when there is one, then the picked image, then a demo asset.
{% endcomment %}

{% liquid
  assign demo_images = 'faf-demo-layal-lace-blouse-1.jpg|faf-demo-rima-tailored-trouser-1.jpg|faf-demo-yara-blazer-set-1.jpg|faf-demo-maya-slip-dress-2.jpg' | split: '|'
  assign demo_titles = 'Tops|Bottoms|Sets|Dresses' | split: '|'
%}

<div class="faf-categories">
  <div class="faf-categories__header">
    {% if section.settings.eyebrow != blank %}
      <p class="faf-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="faf-categories__heading">{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  <ul class="faf-categories__grid" role="list">
    {% for i in (1..4) %}
      {% liquid
        assign idx = forloop.index0
        assign collection_key = 'collection_' | append: i
        assign image_key = 'image_' | append: i
        assign title_key = 'title_' | append: i
        assign collection = section.settings[collection_key]
        assign image = section.settings[image_key] | default: collection.image
        assign title = section.settings[title_key] | default: collection.title | default: demo_titles[idx]
        assign url = collection.url | default: routes.all_products_collection_url
      %}
      <li class="faf-category">
        <a class="faf-category__link" href="{{ url }}">
          <span class="faf-category__media">
            {% if image != blank %}
              {{
                image
                | image_url: width: 1200
                | image_tag:
                  widths: '300, 450, 600, 900, 1200',
                  sizes: '(min-width: 750px) 25vw, 50vw',
                  class: 'faf-category__image',
                  loading: 'lazy',
                  alt: ''
              }}
            {% else %}
              <img class="faf-category__image" src="{{ demo_images[idx] | asset_url }}" alt="" loading="lazy" width="900" height="1200">
            {% endif %}
          </span>
          <span class="faf-category__label">
            <span class="faf-category__title">{{ title }}</span>
            <span class="faf-category__arrow" aria-hidden="true">&rarr;</span>
          </span>
        </a>
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .faf-categories {
    padding: 56px 16px 64px;
    background: transparent;
    color: #000;
  }

  .faf-categories__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-bottom: 36px;
    text-align: center;
  }

  .faf-categories__header .faf-eyebrow {
    color: var(--faf-red);
  }

  .faf-categories__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.875rem, 1.4rem + 1.6vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .faf-categories__grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1180px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 16px;
  }

  .faf-category__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    color: inherit;
    text-decoration: none;
  }

  /* Round badge with a fine double red ring, as in the guideline's highlight icons */
  .faf-category__media {
    display: block;
    width: 100%;
    max-width: 260px;
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 7px;
    border: 1px solid var(--faf-red);
    box-shadow: inset 0 0 0 4px #f5f5f5, inset 0 0 0 5px var(--faf-red);
    overflow: hidden;
    background: #f5f5f5;
    transition: box-shadow 0.3s ease;
  }

  .faf-category__image {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 18%;
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .faf-category__label {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .faf-category__title {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .faf-category__arrow {
    color: var(--faf-red);
    font-size: 1rem;
    transition: transform 0.3s ease;
  }

  @media (hover: hover) {
    .faf-category__link:hover .faf-category__title {
      color: var(--faf-red);
    }

    .faf-category__link:hover .faf-category__arrow {
      transform: translateX(4px);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .faf-category__link:hover .faf-category__image {
      transform: scale(1.05);
    }
  }

  @media screen and (min-width: 750px) {
    .faf-categories {
      padding: 96px 40px 104px;
    }

    .faf-categories__header {
      margin-bottom: 56px;
    }

    .faf-categories__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAF categories",
  "class": "faf-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Collection" },
    { "type": "header", "content": "Tile 1" },
    { "type": "collection", "id": "collection_1", "label": "Collection" },
    { "type": "text", "id": "title_1", "label": "Title (optional)" },
    { "type": "image_picker", "id": "image_1", "label": "Image (optional)" },
    { "type": "header", "content": "Tile 2" },
    { "type": "collection", "id": "collection_2", "label": "Collection" },
    { "type": "text", "id": "title_2", "label": "Title (optional)" },
    { "type": "image_picker", "id": "image_2", "label": "Image (optional)" },
    { "type": "header", "content": "Tile 3" },
    { "type": "collection", "id": "collection_3", "label": "Collection" },
    { "type": "text", "id": "title_3", "label": "Title (optional)" },
    { "type": "image_picker", "id": "image_3", "label": "Image (optional)" },
    { "type": "header", "content": "Tile 4" },
    { "type": "collection", "id": "collection_4", "label": "Collection" },
    { "type": "text", "id": "title_4", "label": "Title (optional)" },
    { "type": "image_picker", "id": "image_4", "label": "Image (optional)" }
  ],
  "presets": [{ "name": "FAF categories" }]
}
{% endschema %}
