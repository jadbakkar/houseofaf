{% comment %}
  House of FAF: brand statement. Monogram, an italic line and an optional link, centred.
  An optional small photo can sit beside the text, like a magazine page.
{% endcomment %}

{% liquid
  assign photo = section.settings.image
  assign demo = section.settings.demo_image
  assign has_photo = false
  if photo != blank or demo != blank
    assign has_photo = true
  endif
%}

<div class="faf-classic faf-classic--{{ section.settings.tone }}{% if section.settings.show_monogram %} faf-classic--mark-{{ section.settings.mark_size | default: 'small' }}{% endif %}{% if has_photo %} faf-classic--with-photo faf-classic--photo-{{ section.settings.image_side | default: 'left' }}{% endif %}">
  {% if has_photo %}
    <div class="faf-classic__layout">
      <div class="faf-classic__photo">
        {% if photo != blank %}
          {{
            photo
            | image_url: width: 800
            | image_tag:
              widths: '300, 480, 640, 800',
              sizes: '(min-width: 750px) 320px, 64vw',
              class: 'faf-classic__image',
              loading: 'lazy',
              alt: photo.alt
          }}
        {% else %}
          <img class="faf-classic__image" src="{{ demo | asset_url }}" alt="" loading="lazy" width="320" height="400">
        {% endif %}
      </div>
  {% endif %}
  <div class="faf-classic__inner">
    {% if section.settings.show_monogram %}
      <span
        class="faf-classic__mark faf-mark"
        aria-hidden="true"
        style="--faf-mark: url('{{ 'faf-monogram.svg' | asset_url }}');"
      ></span>
    {% endif %}
    {% if section.settings.eyebrow != blank %}
      <p class="faf-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="faf-tagline">{{ section.settings.text }}</p>
    {% endif %}
    {% if section.settings.label != blank %}
      <a class="faf-link" href="{{ section.settings.link | default: routes.root_url }}">
        {{- section.settings.label -}}
      </a>
    {% endif %}
  </div>
  {% if has_photo %}
    </div>
  {% endif %}
</div>

{% if section.settings.tone == 'burgundy' %}
  {% style %}
    {{ settings.type_heading_font | font_modify: 'weight', '500' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {% endstyle %}
{% endif %}

{% stylesheet %}
  .faf-classic {
    padding: 56px 20px;
    text-align: center;
  }

  .faf-classic--stone {
    background: var(--faf-stone);
    color: #000;
  }

  .faf-classic--paper {
    background: #fff;
    color: #000;
  }

  .faf-classic--noir {
    background: #000;
    color: #fff;
  }

  /* Deeper than the brand red so the white type has more contrast; slightly heavier italic
     because the regular weight's hairlines wash out on a laptop screen. Size is unchanged. */
  .faf-classic--burgundy {
    background: #5a0f1d;
    color: #fff;
  }

  .faf-classic--burgundy .faf-tagline {
    font-weight: 500;
  }

  .faf-classic__inner {
    max-width: 720px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }

  .faf-classic__mark {
    display: block;
    height: 56px;
    aspect-ratio: 2528 / 2288;
  }

  @media screen and (min-width: 750px) {
    .faf-classic {
      padding: 96px 40px;
    }
  }

  /* Large monogram: the mark carries the section, with more air around it */
  .faf-classic--mark-large {
    padding-block: 72px;
  }

  .faf-classic--mark-large .faf-classic__inner {
    gap: 28px;
  }

  .faf-classic--mark-large .faf-classic__mark {
    height: 96px;
  }

  @media screen and (min-width: 750px) {
    .faf-classic--mark-large {
      padding-block: 112px;
    }

    .faf-classic--mark-large .faf-classic__mark {
      height: 136px;
    }
  }

  /* With a photo: small portrait beside the text */
  .faf-classic__layout {
    max-width: 960px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  /* The photo keeps its own proportions: never cropped */
  .faf-classic__photo {
    flex: none;
    width: min(240px, 64vw);
  }

  .faf-classic__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .faf-classic__layout .faf-classic__inner {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 480px;
    margin-inline: 0;
  }

  @media screen and (min-width: 750px) {
    .faf-classic__layout {
      flex-direction: row;
      justify-content: center;
      gap: clamp(48px, 7vw, 112px);
    }

    .faf-classic--photo-right .faf-classic__layout {
      flex-direction: row-reverse;
    }

    .faf-classic__photo {
      width: 320px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAF statement classic",
  "class": "faf-section",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        { "value": "stone", "label": "Stone" },
        { "value": "paper", "label": "White" },
        { "value": "noir", "label": "Black" },
        { "value": "burgundy", "label": "Burgundy" }
      ],
      "default": "stone"
    },
    { "type": "checkbox", "id": "show_monogram", "label": "Show monogram", "default": true },
    {
      "type": "select",
      "id": "mark_size",
      "label": "Monogram size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small",
      "visible_if": "{{ section.settings.show_monogram }}"
    },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "More than fashion, FAF is a personal expression of confidence, style, and identity."
    },
    { "type": "text", "id": "label", "label": "Link text", "default": "The House" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "header", "content": "Photo" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Optional. A small portrait beside the text." },
    { "type": "text", "id": "demo_image", "label": "Demo image file", "info": "Used until a photo is picked above. Leave empty for no photo." },
    {
      "type": "select",
      "id": "image_side",
      "label": "Photo side",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "presets": [{ "name": "FAF statement classic" }]
}
{% endschema %}
