{% comment %}
  House of FAF: contact. Red card with thin white inner frame on the left, native Shopify contact form on the right.
{% endcomment %}

{% liquid
  assign form_id = 'FafContactForm-' | append: section.id
%}

<div class="faf-contact" style="--faf-mark: url('{{ 'faf-monogram.svg' | asset_url }}');">
  <div class="faf-contact__grid">
    <div class="faf-contact__card">
      <div class="faf-contact__card-body">
        <span class="faf-contact__mark faf-mark" aria-hidden="true"></span>
        <h1 class="faf-contact__name">{{ section.settings.heading }}</h1>
        <span class="faf-contact__rule" aria-hidden="true"></span>
        {% if section.settings.tagline != blank %}
          <p class="faf-tagline faf-contact__tagline">{{ section.settings.tagline }}</p>
        {% endif %}
        <dl class="faf-contact__rows">
          {% if section.settings.email != blank %}
            <div class="faf-contact__row">
              <dt class="faf-eyebrow">{{ section.settings.email_label }}</dt>
              <dd><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></dd>
            </div>
          {% endif %}
          {% if section.settings.instagram != blank %}
            <div class="faf-contact__row">
              <dt class="faf-eyebrow">{{ section.settings.instagram_label }}</dt>
              <dd>
                {% if section.settings.instagram_url != blank %}
                  <a href="{{ section.settings.instagram_url }}">{{ section.settings.instagram }}</a>
                {% else %}
                  {{ section.settings.instagram }}
                {% endif %}
              </dd>
            </div>
          {% endif %}
          {% if section.settings.hours != blank %}
            <div class="faf-contact__row">
              <dt class="faf-eyebrow">{{ section.settings.hours_label }}</dt>
              <dd>{{ section.settings.hours }}</dd>
            </div>
          {% endif %}
        </dl>
      </div>
    </div>

    <div class="faf-contact__form-wrap">
      {% form 'contact', id: form_id, class: 'faf-contact__form' %}
        {%- if form.posted_successfully? -%}
          <p class="faf-contact__message faf-contact__message--success" role="status" tabindex="-1">
            {{- 'blocks.contact_form.post_success' | t -}}
          </p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="faf-contact__message faf-contact__message--error" role="alert" tabindex="-1">
            {%- for field in form.errors -%}
              <p>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</p>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="faf-contact__field">
          <label class="faf-eyebrow" for="{{ form_id }}-name">{{ 'blocks.contact_form.name' | t }}</label>
          <input
            id="{{ form_id }}-name"
            class="faf-contact__input"
            type="text"
            name="contact[name]"
            autocomplete="name"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          >
        </div>

        <div class="faf-contact__field">
          <label class="faf-eyebrow" for="{{ form_id }}-email">{{ 'blocks.contact_form.email' | t }} <span aria-hidden="true">*</span></label>
          <input
            id="{{ form_id }}-email"
            class="faf-contact__input"
            type="email"
            name="contact[email]"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="off"
            required
            aria-required="true"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
          >
        </div>

        <div class="faf-contact__field">
          <label class="faf-eyebrow" for="{{ form_id }}-body">{{ 'blocks.contact_form.comment' | t }}</label>
          <textarea
            id="{{ form_id }}-body"
            class="faf-contact__input faf-contact__input--textarea"
            name="contact[body]"
            rows="7"
          >{{ form.body }}</textarea>
        </div>

        <button class="faf-contact__submit" type="submit">{{ section.settings.button_label }}</button>
      {% endform %}
    </div>
  </div>
</div>

{% stylesheet %}
  .faf-contact {
    padding: 0;
    background: #fff;
    color: #000;
  }

  .faf-contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  .faf-contact__form-wrap {
    padding: 48px 20px 64px;
  }

  .faf-contact__card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding: 56px 28px;
    background: var(--faf-red);
    color: #fff;
    text-align: center;
  }

  .faf-contact__card-body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    max-width: 380px;
    width: 100%;
  }

  .faf-contact__mark {
    display: block;
    height: 72px;
    aspect-ratio: 2528 / 2288;
  }

  .faf-contact__name {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .faf-contact__rule {
    display: block;
    width: 40px;
    height: 1px;
    background: currentColor;
  }

  .faf-contact__rows {
    margin: 16px 0 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .faf-contact__row {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .faf-contact__row dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .faf-contact__row a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: text-underline-offset 0.2s ease;
  }

  .faf-contact__row a:hover {
    color: inherit;
    text-underline-offset: 7px;
  }

  .faf-contact__form-wrap {
    min-width: 0;
    display: flex;
    align-items: center;
  }

  .faf-contact__form {
    width: 100%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .faf-contact__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .faf-contact__field label {
    color: #000;
  }

  .faf-contact__input {
    width: 100%;
    min-height: 48px;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid #000;
    border-radius: 0;
    background: transparent;
    color: #000;
    font-family: var(--font-body--family);
    font-size: 1rem;
    box-shadow: none;
  }

  .faf-contact__input--textarea {
    min-height: 140px;
    resize: vertical;
  }

  .faf-contact__submit {
    width: 100%;
  }

  .faf-contact__input:focus-visible {
    outline: 2px solid var(--faf-red);
    outline-offset: 2px;
  }

  .faf-contact__submit {
    align-self: flex-start;
    min-height: 48px;
    padding: 0 40px;
    border: 1px solid #000;
    border-radius: 0;
    background: #000;
    color: #fff;
    font-family: var(--font-accent--family);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .faf-contact__submit:hover {
    background: var(--faf-red);
    border-color: var(--faf-red);
  }

  .faf-contact__submit:focus-visible {
    outline: 2px solid var(--faf-red);
    outline-offset: 3px;
  }

  .faf-contact__message {
    margin: 0;
    padding: 14px 16px;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .faf-contact__message p {
    margin: 0;
  }

  .faf-contact__message--success {
    border: 1px solid #000;
    color: #000;
  }

  .faf-contact__message--error {
    border: 1px solid var(--faf-red);
    color: var(--faf-red);
  }

  @media screen and (min-width: 750px) {
    .faf-contact {
      padding: 0;
      background: #fff;
    }

    .faf-contact__grid {
      max-width: none;
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }

    .faf-contact__card {
      padding: 112px 48px;
      min-height: 720px;
    }

    .faf-contact__form-wrap {
      justify-content: center;
      padding: 96px 64px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAF contact",
  "class": "faf-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Card heading", "default": "House of FAF" },
    { "type": "text", "id": "tagline", "label": "Italic line", "default": "We would love to hear from you." },
    { "type": "header", "content": "Contact details (placeholders)" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@houseofaf.com" },
    { "type": "text", "id": "instagram_label", "label": "Instagram label", "default": "Instagram" },
    { "type": "text", "id": "instagram", "label": "Instagram handle", "default": "@houseofaf" },
    { "type": "url", "id": "instagram_url", "label": "Instagram link" },
    { "type": "text", "id": "hours_label", "label": "Hours label", "default": "Hours" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Monday to Friday, 9 to 6" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" }
  ],
  "presets": [{ "name": "FAF contact" }]
}
{% endschema %}
