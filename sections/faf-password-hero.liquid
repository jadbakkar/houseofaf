{% comment %}
  House of FAF: password page hero. Black, large white monogram, wordmark, rule, italic line.
{% endcomment %}

<div class="faf-password-hero" style="--faf-mark: url('{{ 'faf-monogram.svg' | asset_url }}');">
  <span class="faf-password-hero__mark faf-mark" aria-hidden="true"></span>
  <h1 class="faf-password-hero__name">{{ section.settings.heading }}</h1>
  <span class="faf-password-hero__rule" aria-hidden="true"></span>
  {% if section.settings.line != blank %}
    <p class="faf-tagline faf-password-hero__line">{{ section.settings.line }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .faf-password-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    min-height: 62vh;
    padding: 64px 20px 24px;
    background: #000;
    color: #fff;
    text-align: center;
  }

  .faf-password-hero__mark {
    display: block;
    height: clamp(120px, 30vw, 240px);
    aspect-ratio: 2528 / 2288;
  }

  .faf-password-hero__name {
    margin: 8px 0 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .faf-password-hero__rule {
    display: block;
    width: 40px;
    height: 1px;
    background: currentColor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAF password hero",
  "class": "faf-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "House of FAF" },
    { "type": "text", "id": "line", "label": "Italic line", "default": "Opening soon." }
  ],
  "presets": [{ "name": "FAF password hero" }]
}
{% endschema %}
